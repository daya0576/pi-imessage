<button type="button" class="detail-button" data-detail-id="<%= it.detailId %>" popovertarget="<%= it.detailId %>" aria-haspopup="dialog" aria-controls="<%= it.detailId %>"><%= it.detailLabel || '详情' %></button>
<div popover class="detail-dialog" role="dialog" id="<%= it.detailId %>" aria-labelledby="<%= it.detailId %>-title">
  <header><h2 id="<%= it.detailId %>-title"><%= it.detailTitle %></h2><button type="button" popovertarget="<%= it.detailId %>" popovertargetaction="hide" autofocus>关闭</button></header>
  <div class="detail-content"><%~ it.detailBody %></div>
</div>
