<!DOCTYPE html>
<html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>blue — automation tasks</title>
<style>
* { box-sizing: border-box }
body { margin: 0; background: #111; color: #ccc; font: 13px/1.6 monospace; display: flex }
nav { width: 112px; flex-shrink: 0; padding: 40px 16px; border-right: 1px solid; }
nav a { display: block; color: inherit; text-decoration: none; opacity: .5; line-height: 2.4 }
nav a:hover, nav a.active { opacity: 1 }
main { padding: 32px; min-width: 0; flex: 1 }
h1, h2, button { font: inherit }
article { border-top: 1px solid; padding: 16px 0; overflow-wrap: anywhere }
p { margin: 4px 0 }
button { color: inherit; background: transparent; border: 1px solid; padding: 4px 10px; margin: 8px 4px 0 0; cursor: pointer }
button:disabled, .dim { opacity: .5 }
@media (max-width: 600px) { body { display: block } nav { width: auto; padding: 12px; border-right: 0; border-bottom: 1px solid } nav a { display: inline-block; margin-right: 12px } main { padding: 16px } }
</style></head><body>
<nav><a href="/">Recent Chats</a><a href="/scheduled">Scheduled</a><a href="/tasks" class="active">Tasks</a><a href="/logs">Logs</a><a href="/memory">Memory</a></nav>
<main><h1>Automation Tasks</h1><p class="dim">Reviewed file configuration only. Resume runs verification. Notification accepted is not verified delivery.</p>
<p id="feedback" role="status"></p>
<% if (!it.tasks.length) { %><p>No automation jobs configured.</p><% } %>
<% it.tasks.forEach(function(task) { %>
<article><h2><%= task.name %></h2>
<p>State: <%= task.state %><%= task.paused ? ' / paused' : '' %><%= !task.enabled ? ' / disabled in config' : '' %><%= task.blocked ? ' / termination unverified — operator required' : '' %></p>
<p>Last success: <%= task.lastSuccess || 'never' %></p><p>Next scheduled check: <%= task.paused || !task.enabled ? 'paused' : task.nextRun || 'worker inactive' %></p>
<p>Reason / action needed: <%= task.reason || 'none' %></p><p>Notification: <%= task.notification %></p>
<button data-id="<%= task.id %>" data-action="pause">Pause</button>
<button data-id="<%= task.id %>" data-action="resume" <%= task.running || task.blocked || !task.enabled ? 'disabled' : '' %>>Resume / verify</button>
<button data-id="<%= task.id %>" data-action="run" <%= task.running || task.paused || task.blocked || !task.enabled ? 'disabled' : '' %>>Run</button>
</article><% }) %>
<h2>Recent runs</h2>
<% it.runs.forEach(function(run) { %><article><p><%= run.taskId %> — <%= run.status %></p><p><%= run.startedAt %> → <%= run.finishedAt || 'running' %></p><p><%= run.summary %></p><p><%= run.reason %></p></article><% }) %>
</main><script>
document.addEventListener('click', async (event) => {
  const button = event.target.closest('button[data-action]');
  if (!button) return;
  button.disabled = true;
  const feedback = document.getElementById('feedback');
  try {
    const response = await fetch('/tasks/' + encodeURIComponent(button.dataset.id) + '/' + button.dataset.action, {
      method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Automation-Action': '1' }, body: '{}'
    });
    feedback.textContent = response.ok ? 'Accepted; refreshing status…' : 'Unavailable. Refresh and check task state.';
    if (response.ok) setTimeout(() => location.reload(), 500);
  } catch { feedback.textContent = 'Request failed; refresh to check state.'; }
  button.disabled = false;
});
setTimeout(() => location.reload(), 15000);
</script></body></html>
